{
  "name": "massage-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @oasis/web dev",
    "dev:web": "pnpm --filter @oasis/web dev",
    "dev:desktop": "pnpm --filter @oasis/desktop dev",
    "build": "pnpm --filter @oasis/web build && pnpm --filter @oasis/desktop build",
    "build:web": "pnpm --filter @oasis/web build",
    "build:desktop": "pnpm --filter @oasis/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  }
}
