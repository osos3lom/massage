# Copy to packages/db/.env and fill in. Never commit the real .env.
#
# Direct Supabase Postgres connection string (Dashboard → Project Settings →
# Database → Connection string → URI). The `postgres` role bypasses RLS, which is
# what you want for migrations and seeding.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# The web app (apps/web) uses these instead (browser Supabase client, anon access).
# They live in the repo-root .env.local, not here.
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=...
